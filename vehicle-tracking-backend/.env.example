# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_tracker

# JWT Security
SECRET_KEY=supersecretkey_change_in_production_1234567890!@#$
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=vehicles/+/gps
MQTT_CLIENT_ID=fastapi-tracking-backend

# App Config
PROJECT_NAME="Vehicle Tracking API"
API_V1_STR=/api/v1
